{
  "name": "maddog986-screeps-2025",
  "version": "1.0.0",
  "description": "Hivemind — a task-scored Screeps AI for room economy, building, and expansion",
  "main": "dist/main.js",
  "//": "CLU INFO: Pause: system.pauseSimulation() Resume: system.pauseSimulation() Tick Rates: system.setTickDuration(1000)",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "build": "rollup -c",
    "push-main": "rollup -c --bundleConfigAsCjs --environment DEST:main",
    "push-pserver": "rollup -c --bundleConfigAsCjs --environment DEST:pserver",
    "push-season": "rollup -c --bundleConfigAsCjs --environment DEST:season",
    "push-sim": "rollup -c --bundleConfigAsCjs --environment DEST:sim",
    "watch-main": "rollup -cw --bundleConfigAsCjs --environment DEST:main",
    "watch-pserver": "rollup -cw --bundleConfigAsCjs --environment DEST:pserver",
    "watch-season": "rollup -cw --bundleConfigAsCjs --environment DEST:season",
    "watch-sim": "rollup -cw --bundleConfigAsCjs --environment DEST:sim",
    "cli": "docker exec -i screeps-docker-screeps-1 npx screeps cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maddog986/screeps-2025.git"
  },
  "author": "Maddog986",
  "license": "Unlicense",
  "engines": {
    "node": "18.x || 20.x || 22.x"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.10.7",
    "@types/screeps": "^3.3.8",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript-eslint/typescript-estree": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.2",
    "lodash": "^3.10.1",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-screeps": "^1.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "source-map": "~0.7.4"
  }
}
